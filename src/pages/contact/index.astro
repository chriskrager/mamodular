---
import Base from '../../layouts/Base.astro';
import { site } from '../../config';
---
<Base title="Contact" description="Tell us about your site and what you want to build. We reply by email with a first read on what can work.">
  <div class="wrap section">
    <h1>Contact us</h1>
    <p class="lede" style="margin-top:20px">Please take some time to fill out our inquiry form. This will help us get a sense of your unique circumstances and needs. We will get back to you as soon as possible.</p>
    <div id="wufoo-zapubv100tjkk2" class="wufoo-embed">
      <p>The inquiry form is loading. If it does not appear, <a href="https://mamodular.wufoo.com/forms/project-inquiry/">open the form on its own page</a>.</p>
    </div>
    <p class="small mute">{site.financingNote}</p>
    <p style="margin-top:32px">Or write to <a href={`mailto:${site.email}`}>{site.email}</a>, call {site.phone}, or visit {site.address.join(', ')}.</p>
  </div>
  <script is:inline>
    var zapubv100tjkk2;
    (function (d, t) {
      var s = d.createElement(t), options = {
        userName: 'mamodular', formHash: 'zapubv100tjkk2', autoResize: true,
        height: '1900', async: true, host: 'wufoo.com', header: 'hide', ssl: true
      };
      s.src = 'https://www.' + options.host + '/scripts/embed/form.js';
      s.onload = s.onreadystatechange = function () {
        var rs = this.readyState; if (rs && rs != 'complete' && rs != 'loaded') return;
        try { zapubv100tjkk2 = new WufooForm(); zapubv100tjkk2.initialize(options); zapubv100tjkk2.display(); } catch (e) {}
      };
      var scr = d.getElementsByTagName(t)[0]; scr.parentNode.insertBefore(s, scr);
    })(document, 'script');
  </script>
</Base>
