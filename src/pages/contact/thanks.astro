---
import Base from '../../layouts/Base.astro';
import { site } from '../../config';
---
<Base title="Thank you" description="We received your inquiry." noindex>
  <!-- The Wufoo form lives in an iframe. If Wufoo redirects here, load this page in the full window instead of inside the form box. -->
  <script is:inline>
    try {
      if (window.top !== window.self) {
        document.documentElement.classList.add('framed');
        window.top.location.replace(window.location.href);
      }
    } catch (e) {}
  </script>
  <style>
    .framed-only { display: none; }
    .framed .framed-only { display: block; }
  </style>
  <div class="wrap section">
    <h1>Thank you.</h1>
    <p class="lede" style="margin-top:20px">We received your inquiry and will reply by email.</p>
    <p style="margin-top:16px">Need to reach us sooner? Call <a href={`tel:${site.phone.replace(/[^\d]/g, '')}`}>{site.phone}</a>.</p>
    <p class="framed-only" style="margin-top:24px"><a class="btn" href="/" target="_top">Continue to mamodular.com</a></p>
    <h2 style="margin-top:48px">While you wait</h2>
    <div class="cards">
      <a class="card" href="/find-your-ma/" target="_top"><h3>Find your ma</h3><p>Browse our plans and see which one fits your lot.</p></a>
      <a class="card" href="/faq/" target="_top"><h3>Read the FAQ</h3><p>Answers to the questions we hear most.</p></a>
      <a class="card" href="/steps/" target="_top"><h3>Getting started</h3><p>The steps from your first call to move-in.</p></a>
    </div>
  </div>
</Base>
