---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---
<Base title="Development projects" description="ma partners with development teams to create projects from single-family homes to 150,000+ sq. ft. mixed use." image={projects[0].photos[0].src}>
  <div class="wrap page-title"><h1>Development projects</h1><p class="lede" style="margin-top:16px">ma partners with development teams to create projects from single-family homes to 150,000+ sq. ft. mixed use.</p></div>
  <div class="wrap section" style="padding-top:8px">
    <div class="cards">
      {projects.map((p) => <a class="card" href={`/portfolio/${p.slug}/`}><img src={p.photos[0].src} alt={p.photos[0].alt} loading="lazy" /><h3>{p.name}</h3><p>{p.kind}</p></a>)}
    </div>
  </div>
</Base>
