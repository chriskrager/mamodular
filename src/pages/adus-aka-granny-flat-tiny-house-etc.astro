---
import Base from '../layouts/Base.astro';
import Plans from '../components/Plans.astro';
import PlanTiles from '../components/PlanTiles.astro';
import { aduPlans } from '../data/plans';
import { models } from '../data/models';
import { site } from '../config';
---
<Base title="ADU's (aka granny flat, tiny house, etc)" description="Three pre-designed ADUs from 550 to 1,100 square feet: guest house, granny flat, backyard income generator or home studio.">
  <div class="wrap page-title"><h1>ADU&rsquo;s (aka granny flat, tiny house, etc)</h1></div>
  <div class="wrap section" style="padding-top:12px">
    <p class="lede">Are you looking for an ADU? A &ldquo;tiny house&rdquo;? A flat for your granny? Guest house? Backyard income generator? Home studio?</p>
    <p>Look no further, ma modular has a solution for you. We have three pre-designed units to fit a variety of sizes and needs.</p>
    <p>These small buildings have gained significant traction in the last few years, due to their flexibility, accessibility and lower cost.</p>
    <PlanTiles list={aduPlans} />
  </div>
  <section class="section alt">
    <div class="wrap">
      <h2>At the same scale</h2>
      <p style="margin-top:12px">Each outline is true to scale, so you can see what will fit behind your house.</p>
      <Plans list={models} />
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <h2>Financing</h2>
      <div class="stack">
        <p>Second-lien construction loans for ADUs are available through the lender we refer our clients to. The loan is underwritten with the rent the new unit is projected to earn.</p>
        <p class="small mute">{site.financingNote}</p>
        <p><a class="btn" href="/contact/">Tell us about your lot</a></p>
      </div>
    </div>
  </section>
</Base>
