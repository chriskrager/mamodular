---
<Base title="Features" description="What goes into every ma modular home, with the standard and premium finish options: exterior, interior, cabinets, tile, countertops, plumbing, appliances and lighting.">
  <div class="wrap page-title"><h1>Features</h1></div>
  <div class="wrap" style="padding-bottom:clamp(32px,5vw,64px)">
    <img class="diagram" src="/images/features/diagram.webp" alt="Cutaway of a ma modular home labeling the standing seam metal roof, thermally broken low-E windows, glass mosaic tile, painted white base and door trim, bamboo floor, quartzite countertops, KCMA certified cabinets, light orange-peel sheetrock finish and R-19 floor and wall insulation with R30-50 ceiling insulation." width="1600" height="882" data-zoom />
  </div>
  {[['Standard Options', standard, 'std'], ['Premium Options', premium, 'prem']].map(([label, groups, cls]) => (
    <section class={`opts ${cls}`}>
      <div class="wrap">
        <h2>{label}*</h2>
        <ul class="opt-grid">
          {groups.map((g, n) => (
            <li>
              <button type="button" class="opt" data-open={`${cls}-${n}`}>
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[g.i]} />
                <span class="name">{g.t}</span>
                <span class="view">View</span>
              </button>
              <dialog class="opt-dlg" id={`${cls}-${n}`} aria-label={`${label}: ${g.t}`}>
                <form method="dialog"><button class="x" aria-label="Close">&times;</button></form>
                <h3>{g.t}</h3>
                <div class="opt-imgs">{g.p.map((p) => <figure><img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" /><figcaption>{p.alt}</figcaption></figure>)}</div>
              </dialog>
            </li>
          ))}
        </ul>
        {cls === 'prem' && <p class="alt-note">*Alternative materials are available per manufacturer</p>}
      </div>
    </section>
  ))}
  <script is:inline>
    document.querySelectorAll('[data-open]').forEach(function (b) {
      b.addEventListener('click', function () { var d = document.getElementById(b.getAttribute('data-open')); if (d && d.showModal) d.showModal(); });
    });
    document.querySelectorAll('.opt-dlg').forEach(function (d) {
      d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
    });
  </script>
</Base>
