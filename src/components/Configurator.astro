---
import { cfg550 } from '../data/configurator';
const c = cfg550;
---
<section class="cfg" id="customize" data-cfg={JSON.stringify(c)} aria-labelledby="cfg-h">
  <div class="wrap">
    <h2 id="cfg-h">Customize your ma</h2>
    <p class="lede">Choose finishes for the {c.name} and see them on the house. Drag to look around. Colors are approximate; your actual selections are confirmed with you.</p>
    <div class="cfg-grid">
      <div class="cfg-stage">
        <div class="cfg-canvas" role="img" aria-label={`Interactive 3D model of the ${c.name}. Drag to rotate, scroll or pinch to zoom.`}>
          <p class="cfg-msg" data-msg>Loading 3D model…</p>
        </div>
        <div class="cfg-views" role="group" aria-label="View">
          <button type="button" data-view="ext" aria-pressed="true">Exterior</button>
          <button type="button" data-view="int" aria-pressed="false">Inside (roof off)</button>
          <button type="button" data-view="top" aria-pressed="false">From above</button>
        </div>
      </div>
      <div class="cfg-panel">
        {c.slots.map((s) => (
          <fieldset class="cfg-group" data-slot={s.id}>
            <legend>{s.label}: <span data-cur>{s.opts[s.def].name}</span></legend>
            <div class="cfg-opts">
              {s.opts.map((o, i) => (
                <button type="button" class="cfg-opt" data-i={i} aria-pressed={i === s.def ? 'true' : 'false'} title={o.name}>
                  <span class="cfg-chip" style={`background:${o.color}`}></span><span class="cfg-name">{o.name}</span>
                </button>
              ))}
            </div>
          </fieldset>
        ))}
        <div class="cfg-actions">
          <a class="btn" href="/contact/" data-send>Send my selections</a>
          <button type="button" class="btn btn-quiet" data-reset>Reset</button>
        </div>
        <p class="small mute">Not sure yet? That is fine. Your choices are a starting point for the conversation, not an order.</p>
      </div>
    </div>
  </div>
</section>
<script>
  const root = document.getElementById('customize') as HTMLElement;
  const cfg = JSON.parse(root.dataset.cfg!);
  let started = false;
  async function start() {
    if (started) return; started = true;
    const msg = root.querySelector('[data-msg]') as HTMLElement;
    try {
      const THREE = await import('three');
      const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
      const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
      const host = root.querySelector('.cfg-canvas') as HTMLElement;
      const renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      host.appendChild(renderer.domElement);
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0xf1f5f7);
      scene.add(new THREE.HemisphereLight(0xffffff, 0x8a8f90, 1.5));
      const sun = new THREE.DirectionalLight(0xffffff, 2.2); sun.position.set(8, 12, 9); scene.add(sun);
      const fill = new THREE.DirectionalLight(0xffffff, 0.7); fill.position.set(-8, 5, -6); scene.add(fill);
      const cam = new THREE.PerspectiveCamera(35, 1, 0.1, 200);
      const controls = new OrbitControls(cam, renderer.domElement);
      controls.enablePan = false; controls.enableDamping = true; controls.minDistance = 4; controls.maxDistance = 40;
      controls.maxPolarAngle = Math.PI / 2 - 0.02;
      controls.listenToKeyEvents(renderer.domElement); renderer.domElement.tabIndex = 0;
      const views: Record<string, { p: number[]; t: number[]; roof: boolean }> = {
        ext: { p: [6.5, 5, 15], t: [0, 1.3, 0], roof: true },
        int: { p: [4, 13, 11], t: [0, 0.8, 0], roof: false },
        top: { p: [0, 22, 0.1], t: [0, 0, 0], roof: false },
      };
      const mats: Record<string, any> = {};
      const mk = (id: string, o: any) => {
        const m = new THREE.MeshStandardMaterial({ color: o.color, roughness: o.rough ?? 0.7, metalness: o.metal ?? 0, side: THREE.DoubleSide });
        if (o.opacity) { m.transparent = true; m.opacity = o.opacity; m.depthWrite = false; }
        mats[id] = m; return m;
      };
      const slotOf: Record<string, any> = {};
      cfg.slots.forEach((s: any) => s.mat.forEach((id: string) => (slotOf[id] = s)));
      const gltf: any = await new Promise((res, rej) => new GLTFLoader().load(cfg.model, res, undefined, rej));
      const parts: Record<string, any> = {};
      gltf.scene.traverse((o: any) => {
        if (!o.isMesh) return;
        const id = o.name;
        o.material = slotOf[id] ? mk(id, { color: slotOf[id].opts[slotOf[id].def].color, rough: slotOf[id].rough, metal: slotOf[id].metal }) : mk(id, cfg.fixed[id] ?? { color: '#dddddd' });
        parts[id] = o;
      });
      scene.add(gltf.scene);
      const state: Record<string, number> = {}; cfg.slots.forEach((s: any) => (state[s.id] = s.def));
      let dirty = true; const draw = () => { dirty = true; };
      controls.addEventListener('change', draw);
      const setView = (v: string) => {
        const w = views[v];
        cam.position.set(...(w.p as [number, number, number])); controls.target.set(...(w.t as [number, number, number])); controls.update();
        cfg.roofOff.forEach((id: string) => parts[id] && (parts[id].visible = w.roof));
        root.querySelectorAll('[data-view]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.view === v)));
        draw();
      };
      const size = () => { const w = host.clientWidth, h = host.clientHeight; renderer.setSize(w, h); cam.aspect = w / h; cam.updateProjectionMatrix(); draw(); };
      new ResizeObserver(size).observe(host); size();
      (function loop() { requestAnimationFrame(loop); if (controls.update() || dirty) { renderer.render(scene, cam); dirty = false; } })();
      msg.remove(); setView('ext');
      root.querySelectorAll('[data-view]').forEach((b) => b.addEventListener('click', () => setView((b as HTMLElement).dataset.view!)));
      const apply = (sid: string, i: number) => {
        const s = cfg.slots.find((x: any) => x.id === sid); state[sid] = i;
        s.mat.forEach((m: string) => mats[m]?.color.set(s.opts[i].color));
        const g = root.querySelector(`[data-slot="${sid}"]`)!;
        g.querySelectorAll('.cfg-opt').forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
        g.querySelector('[data-cur]')!.textContent = s.opts[i].name; draw(); sync();
      };
      const summary = () => cfg.slots.map((s: any) => `${s.label}: ${s.opts[state[s.id]].name}`).join('; ');
      const sync = () => { (root.querySelector('[data-send]') as HTMLAnchorElement).href = `/contact/?model=${cfg.slug}&sel=${encodeURIComponent(summary())}#selections`; };
      root.querySelectorAll('.cfg-group').forEach((g) => g.querySelectorAll('.cfg-opt').forEach((b) => b.addEventListener('click', () => apply((g as HTMLElement).dataset.slot!, +(b as HTMLElement).dataset.i!))));
      root.querySelector('[data-reset]')!.addEventListener('click', () => cfg.slots.forEach((s: any) => apply(s.id, s.def)));
      sync();
    } catch (e) {
      msg.textContent = 'The 3D viewer could not start on this device. You can still see photos of this house above, or tell us what you have in mind.';
    }
  }
  if ('IntersectionObserver' in window) new IntersectionObserver((en, ob) => { if (en[0].isIntersecting) { ob.disconnect(); start(); } }, { rootMargin: '300px' }).observe(root);
  else start();
</script>
